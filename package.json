{
  "name": "@kicearena/mondrian",
  "version": "0.1.1",
  "type": "module",
  "description": "Deterministic Mondrian panel geometry, colors and keyed placement.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kicearena/mondrian.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json && prettier --check ."
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.8",
    "@types/node": "25.9.1",
    "prettier": "3.8.4"
  },
  "license": "UNLICENSED"
}
